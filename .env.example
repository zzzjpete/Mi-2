# 医学知识 RAG 问答服务 —— 环境变量样例
# 复制成 .env 后按需改；.env 不进 git（.gitignore 已排除），.env.example 进。
#
# 优先级：命令行参数 > 环境变量 > .env > 默认值。
# 所以 README 里那些 `--mode live --translate llm` 的命令仍然有效，且优先。
#
# ⚠ 不支持行尾注释：`MEDRAG_MODE=live  # 真检索` 会把 `# 真检索` 读进值里。
#   注释请单独一行（和 .gitignore 一个道理）。

MEDRAG_HOST=127.0.0.1
MEDRAG_PORT=8000
MEDRAG_LOG_LEVEL=INFO
MEDRAG_LOG_DIR=E:\rag\logs\service
MEDRAG_MODE=snapshot
MEDRAG_SNAPSHOT=E:\rag\report_data\检索快照_live.json
MEDRAG_BM25_DIR=E:\rag\data\bm25_index_4m
MEDRAG_CHROMA_DIR=E:\rag\data\chroma_db_4m
MEDRAG_TRANSLATE=dict
MEDRAG_MODEL=qwen3:8b
MEDRAG_BASE_URL=http://localhost:11434
MEDRAG_NUM_CTX=12288
MEDRAG_LLM_TIMEOUT=180
MEDRAG_MAX_CONTEXT_TOKENS=2800
MEDRAG_CONSTRAINED=true
MEDRAG_REPAIR_ROUNDS=1
MEDRAG_SESSION_DB=E:\rag\data\service\sessions.db
MEDRAG_SESSION_TTL_DAYS=30.0
MEDRAG_HISTORY_TURNS=4
MEDRAG_REWRITE=llm
MEDRAG_CALLS_DB=E:\rag\data\service\api_calls.db
MEDRAG_DOCS_DB=E:\rag\data\docs_catalog.db
MEDRAG_INDEX_STATS=E:\rag\data\index_stats.json
MEDRAG_MAX_CONCURRENT=2
MEDRAG_ACQUIRE_TIMEOUT=30.0
# 非空即开启鉴权；留空 = 不鉴权（单机离线默认）
MEDRAG_API_KEY=
MEDRAG_RATE_LIMIT=0
MEDRAG_CORS_ORIGINS=*
MEDRAG_DOCS_ENABLED=true
MEDRAG_WARMUP=false
